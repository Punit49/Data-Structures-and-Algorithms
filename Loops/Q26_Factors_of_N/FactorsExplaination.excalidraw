      ],
      "updated": 1785349818188,
      "link": null,
      "locked": false,
      "text": "An Optimized approach is to check till square\nroot of n only, coz every factor > root of n\nhave a corresponding factor < root of n as\nthe factors exists in pairs, so we dont need\nto go till n just square root of n is enough.  ",
      "fontSize": 33.18957781577491,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Optimized approach is to check till square root of n only, coz every factor > root of n have a corresponding factor < root of n as the factors exists in pairs, so we dont need to go till n just square root of n is enough.  ",
      "autoResize": false,
      "lineHeight": 1.25
    },
